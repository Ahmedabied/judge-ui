{
  "name": "judge-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Grade search results with the keyboard. Loads a pool file, keeps progress in the browser, exports qrels.",
  "license": "MIT",
  "author": "Ahmed Abied",
  "type": "module",
  "scripts": {
